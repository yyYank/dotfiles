[alias]
	st = status -sb
	df = diff --name-status
	d  = diff
	ds = diff --staged
	last = show --stat --patch --decorate HEAD
	lp = log -p --decorate --oneline -n 5
	dw = diff -w
	dm = diff --color-moved
	dp = diff --patience
	sw = show -w
	sm = show --color-moved
	sp = show --patience
	origins = !git config --global --list --show-origin
	where = "!f() { git config --show-origin --get \"$1\"; }; f"
	tree   = log --oneline --graph --decorate --all
	recent = log --oneline -10
	br     = branch -vv
