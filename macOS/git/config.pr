[alias]
	prstat  = !git fetch -q origin main && git diff --stat origin/main...HEAD
	prfiles = !git fetch -q origin main && git diff --name-status origin/main...HEAD
	pr      = !git fetch -q origin main && git diff origin/main...HEAD
	pr0     = diff origin/main...HEAD
	prw     = !git fetch -q origin main && git diff -w origin/main...HEAD
	prm     = !git fetch -q origin main && git diff --color-moved origin/main...HEAD
	prp     = !git fetch -q origin main && git diff --patience origin/main...HEAD
	prview  = !gh pr view
	prlist  = !gh pr list
	prdiff  = !gh pr diff | diff-so-fancy | less -R
	prco    = !gh pr checkout
