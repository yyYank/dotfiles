# prompt: show directory and filename only
set promptfmt "\033[34;1m%d\033[0m\033[1m%f\033[0m"

# two pane layout (directory + preview)
set ratios 1:2

# show hidden files
set hidden

# preview
set preview true
set previewer ~/.config/lf/preview.sh
set cleaner ~/.config/lf/cleaner.sh

# open file with bat
cmd open $bat --paging=always --color=always "$f"
map e $vim "$f"

# delete file/directory
cmd delete ${{
    printf "delete '$fx'? [y/n] "
    read -r ans
    [ "$ans" = "y" ] && rm -rf "$fx"
}}
map D delete
