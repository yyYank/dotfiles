{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Read(~/.zshrc)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.credentials*)",
      "Read(./**/credentials*)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.config/gh/*)",
      "Bash(gh repo *)",
      "Bash(gh pr merge)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(terraform *)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(gh api */pulls/*/reviews*)",
      "Bash(gh api */pulls/*/comments*)",
      "Read(~/.claude/projects/**/memory/**)",
      "Write(~/.claude/projects/**/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)"
    ]
  },
  "model": "claude-opus-4-6",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/halt-on-uncertainty.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-permit-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/edit-permit-gate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-status.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-brevity.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-uncertainty.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-forge-ahead.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-status.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/guardrail_prompt.txt"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/permit-flag.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "agentPushNotifEnabled": true
}
